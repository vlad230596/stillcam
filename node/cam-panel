class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/":
            page = PAGE.replace("__LABELS__", json.dumps(CONTROLS, ensure_ascii=False))
            self._send(200, page, "text/html; charset=utf-8")
        elif path == "/api/status":
            self._send(200, json.dumps(status(), ensure_ascii=False))
        else:
            self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        length = int(self.headers.get("Content-Length", 0))
        try:
            payload = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            self._send(400, json.dumps({"ok": False, "error": "bad json"}))
            return

        if path == "/api/camera":
            name = str(payload.get("name", ""))
            value = int(payload.get("value", 0))
            if not re.fullmatch(r"[a-z_]+", name):
                self._send(400, json.dumps({"ok": False, "error": "bad control"}))
                return
            err = sh("v4l2-ctl -d %s --set-ctrl=%s=%d 2>&1" % (DEVICE, name, value))
            self._send(200, json.dumps({"ok": err == "", "error": err}, ensure_ascii=False))

        elif path == "/api/stream":
            try:
                before = load_conf()
                conf = save_conf(payload)
                # same parameters as the running stream - do not break it for nothing
                restart = conf != before or sh("systemctl is-active mediamtx") != "active"
                if restart:
                    subprocess.run(["systemctl", "restart", "mediamtx"], timeout=30)
                self._send(200, json.dumps({"ok": True, "conf": conf, "restarted": restart}))
            except Exception as e:
                self._send(500, json.dumps({"ok": False, "error": str(e)}))

        elif path == "/api/action":
            action = payload.get("action")
            if action in ("start", "stop", "restart"):
                subprocess.run(["systemctl", action, "mediamtx"], timeout=45)
                self._send(200, json.dumps({"ok": True, "action": action}))
            else:
                self._send(400, json.dumps({"ok": False, "error": "unknown action"}))

        elif path == "/api/autoexposure":
            on = bool(payload.get("on"))
            try:
                self._send(200, json.dumps(set_autoexposure(on), ensure_ascii=False))
            except Exception as e:
                self._send(500, json.dumps({"ok": False, "error": str(e)}))
        else:
            self._send(404, json.dumps({"error": "not found"}))


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


if __name__ == "__main__":
    with Server(("", PORT), Handler) as httpd:
        httpd.serve_forever()
