#!/usr/bin/env python3
"""Service panel for the radxa-cam node.

Serves a small control page on :8080 - live telemetry, camera controls applied
straight through v4l2, and stream parameters that take effect on restart.
Standard library only: the board may sit on a network with no internet.
"""
import http.server
import json
import os
import re
import socketserver
import subprocess
import time
import urllib.parse

PORT = 8080
CONF = "/usr/local/etc/cam-stream.conf"
# The stream reads the ISP self path; the main path stays free for full-frame
# measurement stills (host/still.py), taken while the stream keeps running.
STREAM_DEVICE = "/dev/video1"
# Sensor controls (exposure, gain...) are the IMX219's own and show up on every
# video node of the ISP with the same values; /dev/video0 is where still.py and
# snap.ps1 set them too, so the panel uses it as well.
DEVICE = "/dev/video0"

# Controls we expose, in the order they appear on the page.
CONTROLS = [
    ("exposure",        "Exposure",              "lines"),
    ("gain",            "Gain",                  ""),
    ("analogue_gain",   "Analogue gain",         ""),
    ("horizontal_flip", "Horizontal flip",       ""),
    ("vertical_flip",   "Vertical flip",         ""),
    ("test_pattern",    "Test pattern",          ""),
]

MODES_FILE = "/usr/local/etc/cam-modes.conf"

NICE_NAMES = {
    (3280, 2464): "full frame, 8 MP",
    (1920, 1088): "almost Full HD",
    (1600, 1200): "2 MP 4:3",
    (1280, 720):  "HD",
    (640, 480):   "VGA",
}


def sensor_modes():
    """The sensor's own modes, as discovered by cam-probe-modes."""
    modes = []
    try:
        with open(MODES_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                size, fps, sensor = line.split()
                w, h = (int(x) for x in size.split("x"))
                sw, sh = (int(x) for x in sensor.split("x"))
                note = NICE_NAMES.get((w, h), "")
                label = "%d×%d, %s fps" % (w, h, fps)
                if note:
                    label += " — " + note
                modes.append([w, h, int(fps), label, sw, sh])
    except Exception:
        modes = [[1920, 1088, 21, "1920×1088, 21 fps", 3280, 2464]]
    modes.sort(key=lambda m: -(m[0] * m[1]))
    return modes


def sh(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True,
                              timeout=15).stdout.strip()
    except Exception:
        return ""


def read_int(path, div=1):
    try:
        with open(path) as f:
            return int(f.read().strip()) // div
    except Exception:
        return None


def load_conf():
    conf = {"WIDTH": 1920, "HEIGHT": 1088, "FPS": 21, "SENSOR_W": 3280, "SENSOR_H": 2464,
            "BITRATE": 6000000, "GOP": 30, "DEVICE": STREAM_DEVICE}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    if k == "DEVICE":
                        conf[k] = v.strip()
                    elif k in conf:
                        try:
                            conf[k] = int(v)
                        except ValueError:
                            pass
    except Exception:
        pass
    return conf


def save_conf(new):
    conf = load_conf()
    # DEVICE is not taken from the page: it is a node path that goes into a
    # shell command line, and the page has no business choosing it.
    conf.update({k: int(v) for k, v in new.items() if k in conf and k != "DEVICE"})
    with open(CONF, "w") as f:
        f.write("# Stream parameters. Changing these requires restarting mediamtx.\n")
        for k, v in conf.items():
            f.write("%s=%s\n" % (k, v))
    return conf


def camera_controls():
    """Current values and ranges, parsed from v4l2-ctl."""
    out = sh("v4l2-ctl -d %s --list-ctrls" % DEVICE)
    found = {}
    for line in out.splitlines():
        m = re.match(r"\s*(\w+)\s+0x[0-9a-f]+\s+\((\w+)\)\s*:\s*(.*)", line)
        if not m:
            continue
        name, ctype, rest = m.group(1), m.group(2), m.group(3)
        item = {"type": ctype}
        for key in ("min", "max", "step", "default", "value"):
            mm = re.search(r"\b%s=(-?\d+)" % key, rest)
            if mm:
                item[key] = int(mm.group(1))
        found[name] = item
    return found


def set_autoexposure(on):
    """Toggle the 3A daemon, restarting the pipeline around it.

    The order matters, and getting it wrong is what made the stream go mono.
    rkaiq_3A_server latches onto the ISP only on the stream-start event it
    receives from /dev/video9. Touch it while the pipeline is already running
    and both directions break: killed mid-stream it leaves the ISP with default
    params and the picture turns grey, started mid-stream it either sits in
    "wait stream start event" forever or spins on "stats disorder" - either way
    no colour and no auto exposure until the pipeline is restarted.

    So the daemon is only ever switched while mediamtx is down. Cost is the
    same few seconds of stream gap a mode change already has.
    """
    # Already in the requested mode: nothing to do, and restarting anyway costs a
    # stream gap on every call - scripts ask for manual mode before each shot.
    if (sh("systemctl is-active rkaiq_3A") == "active") == on:
        return {"ok": True, "on": on, "restarted": False, "kept": {}}

    streaming = sh("systemctl is-active mediamtx") == "active"

    # Going manual, freeze what 3A had converged on: restarting the pipeline
    # resets the sensor to driver defaults (exposure 158, analogue_gain 256),
    # which is a near-black frame and looks like a second bug.
    keep = {}
    if not on:
        ctrls = camera_controls()
        for name in ("exposure", "gain", "analogue_gain"):
            if name in ctrls and "value" in ctrls[name]:
                keep[name] = ctrls[name]["value"]

    if streaming:
        subprocess.run(["systemctl", "stop", "mediamtx"], timeout=45)
    # restart rather than start: a daemon left stuck by an older toggle has to
    # go away first, and restart is a no-op cost when it was not running
    subprocess.run(["systemctl", "restart" if on else "stop", "rkaiq_3A"], timeout=45)
    if streaming:
        subprocess.run(["systemctl", "start", "mediamtx"], timeout=45)
        if keep:
            time.sleep(4)   # the pipeline has to open its video node first
            for name, value in keep.items():
                sh("v4l2-ctl -d %s --set-ctrl=%s=%d" % (DEVICE, name, value))

    return {"ok": True, "on": on, "restarted": streaming, "kept": keep}


def status():
    temp = read_int("/sys/class/thermal/thermal_zone0/temp", 1000)
    cpu = read_int("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq", 1000)
    ddr = read_int("/sys/class/devfreq/dmc/cur_freq", 1000000)

    fan_cur = fan_max = None
    for d in sorted(os.listdir("/sys/class/thermal")):
        if d.startswith("cooling_device"):
            p = "/sys/class/thermal/" + d
            try:
                with open(p + "/type") as f:
                    if f.read().strip() == "pwm-fan":
                        fan_cur = read_int(p + "/cur_state")
                        fan_max = read_int(p + "/max_state")
            except Exception:
                pass

    try:
        with open("/proc/loadavg") as f:
            load = f.read().split()[0]
    except Exception:
        load = "?"
    try:
        with open("/proc/uptime") as f:
            up = int(float(f.read().split()[0]))
    except Exception:
        up = 0
    mem = None
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemAvailable"):
                    mem = int(line.split()[1]) // 1024
    except Exception:
        pass

    stream = sh("systemctl is-active mediamtx") or "unknown"
    publishing = sh("pgrep -c gst-launch-1.0") not in ("", "0")

    # measured by fpsdisplaysink inside the pipeline - the delivered rate, not the
    # one we asked for
    fps = None
    if publishing:
        try:
            with open("/run/cam-fps") as f:
                fps = round(float(f.read().strip()), 1)
        except Exception:
            fps = None

    # the rkaiq 3A daemon drives auto exposure; stopping it is the only way to
    # make manual exposure and gain stick
    autoexposure = sh("systemctl is-active rkaiq_3A") == "active"

    return {
        "temp": temp, "cpu": cpu, "ddr": ddr,
        "fan": fan_cur, "fan_max": fan_max,
        "load": load, "uptime": up, "mem": mem,
        "stream": stream, "publishing": "yes" if publishing else "no",
        "fps": fps, "autoexposure": autoexposure,
        "conf": load_conf(),
        "controls": camera_controls(),
        "modes": sensor_modes(),
        "host": sh("hostname"),
    }


