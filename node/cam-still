            stride, frame_bytes = set_format(w, h)
            ctl = get_controls()
        except Exception as e:
            return self._error(500, "capture_failed", str(e))

        head = json.dumps({"format": "NV12", "width": w, "height": h, "stride": stride,
                           "frame_bytes": frame_bytes, "frames": n, "skip": pre + post,
                           "controls": ctl, "device": A.device, "service": VERSION}).encode()
