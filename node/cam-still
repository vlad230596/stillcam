    const v = sharpness(px, w, h);
    t.ema = t.ema == null ? v : t.ema + EMA * (v - t.ema);
    t.peak = Math.max(t.peak, t.ema);
    t.hist.push(t.ema); if (t.hist.length > HISTORY) t.hist.shift();
    const p = t.peak ? 100 * t.ema / t.peak : 0;
    t.score.textContent = t.ema.toPrecision(4);
