        finally:
            timer.cancel()
            if src.poll() is None:
                src.kill()
                src.wait()
        t_end = time.time()
        got = max(0, seen - pre - post)
        if rc != 0 or got < n:
            e = err.decode(errors="replace").strip()
            log("capture broke: %d of %d frames dequeued, v4l2-ctl rc %s (client sees a short body) %s"
                % (got, n, rc, e[-400:]))
