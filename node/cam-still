  const mbs = bytesAt.reduce((a, b) => a + b[1], 0) / 3 / 1e6;
  const c = head.controls ? `exposure ${head.controls.exposure}, gain ${head.controls.analogue_gain} / ${head.controls.gain}` : 'controls ?';
  status(`frame #${head.seq} · display ${fps.toFixed(1)} fps · camera ${head.fps ?? '?'} fps · dropped ${lastDropped} · ${mbs.toFixed(2)} MB/s · ${c}`);
}

