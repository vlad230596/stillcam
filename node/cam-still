        log("GRAB %d frames %dx%d, first frame %.2f s, warm-up %.2f s, frames %.2f s (%.1f fps), controls %s"
            % (n, w, h, (t_first or t0) - t0, (t_data or t0) - t0, t_end - (t_data or t0), fps, ctl))


