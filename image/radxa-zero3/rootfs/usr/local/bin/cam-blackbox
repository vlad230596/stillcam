#!/bin/bash
LOG=/var/log/cam-blackbox.log
IF=end1
exec >>"$LOG" 2>&1
echo "=== sampler started $(date -Is) ==="
while true; do
    printf '%s carrier=%s speed=%s rx_err=%s tx_err=%s rx_drop=%s tx_drop=%s rx=%s tx=%s temp=%sC cpu=%sMHz load=%s memfree=%sMB\n' \
        "$(date +%H:%M:%S)" \
        "$(cat /sys/class/net/$IF/carrier 2>/dev/null)" \
        "$(cat /sys/class/net/$IF/speed 2>/dev/null)" \
        "$(cat /sys/class/net/$IF/statistics/rx_errors 2>/dev/null)" \
        "$(cat /sys/class/net/$IF/statistics/tx_errors 2>/dev/null)" \
        "$(cat /sys/class/net/$IF/statistics/rx_dropped 2>/dev/null)" \
        "$(cat /sys/class/net/$IF/statistics/tx_dropped 2>/dev/null)" \
        "$(cat /sys/class/net/$IF/statistics/rx_bytes 2>/dev/null)" \
        "$(cat /sys/class/net/$IF/statistics/tx_bytes 2>/dev/null)" \
        "$(( $(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0) / 1000 ))" \
        "$(( $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null || echo 0) / 1000 ))" \
        "$(cut -d' ' -f1 /proc/loadavg)" \
        "$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)"
    sleep 1
done
