[Unit]
Description=MediaMTX streaming server (radxa-cam)
After=network.target
Wants=network.target
# A pipeline that keeps dying must not loop forever (docs/radxa-zero3.md, "Not done yet")
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
ExecStart=/usr/local/bin/mediamtx /usr/local/etc/mediamtx.yml
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
